# SoftyFy — frontend environment variable reference (NOT a real config file)
#
# Copy this file to `.env` and fill in real values. The real `.env` is
# git-ignored. Variables prefixed with VITE_ are exposed to the client and
# baked in at build time.

# Base URL of the SoftyFy backend API.
# Local development: the Spring Boot instance on localhost.
VITE_API_BASE_URL=http://localhost:8080
