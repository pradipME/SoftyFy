# ── Google Drive API keys (audio streaming) ────────────────────────────────
# SoftyFy streams every song through the Drive API (`alt=media`). Multiple
# keys are rotated round-robin across the song library so no single key's
# download quota gets exhausted.
#
# Usage:
#   - Scripts that rewrite songs.ts read SOFTYFY_DRIVE_API_KEY_1..3 first,
#     falling back to VITE_DRIVE_API_KEY_1..3. Load them with:
#         node --env-file=.env scripts/link-drive-songs.mjs
#   - The Vite build picks up VITE_DRIVE_API_KEY_* automatically (import.meta.env).
#
# All values are optional. With no env key set, a built-in default key is used
# as a single key — this preserves the existing behavior exactly.
# Legacy override: SOFTYFY_DRIVE_API_KEY (singular) is honored when no numbered
# keys are configured.

SOFTYFY_DRIVE_API_KEY_1=
SOFTYFY_DRIVE_API_KEY_2=
SOFTYFY_DRIVE_API_KEY_3=

VITE_DRIVE_API_KEY_1=
VITE_DRIVE_API_KEY_2=
VITE_DRIVE_API_KEY_3=