# ===========================================================================
# SoftyFy — environment variable reference (NOT a real config file)
#
# Copy this file to `.env` (or set the variables in your shell / CI / Render
# dashboard) and fill in real values. The real `.env` file is git-ignored and
# must NEVER be committed.
#
# Values below are safe local-development placeholders only.
# ===========================================================================

# --- Backend (Spring Boot) ---
# Spring profile: local (development) or prod (production).
SOFTYFY_PROFILE=local

# HTTP port exposed by the backend.
SERVER_PORT=8080

# --- PostgreSQL (used by docker-compose.yml and the backend) ---
SOFTYFY_DB_HOST=localhost
SOFTYFY_DB_PORT=5432
SOFTYFY_DB_NAME=softyfy
SOFTYFY_DB_USER=softyfy
# Dev-only placeholder. Use a strong random value in any real environment.
SOFTYFY_DB_PASSWORD=softyfy

# --- Frontend (Vite build-time) ---
# Base URL of the backend API consumed by the frontend.
# For local development this is the Spring Boot instance on localhost.
VITE_API_BASE_URL=http://localhost:8080
