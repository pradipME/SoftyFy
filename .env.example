# ===========================================================================
# SoftyFy — environment variable reference (NOT a real config file)
#
# Copy this file to `.env` (or set the variables in your shell / CI / Render
# dashboard) and fill in real values. The real `.env` file is git-ignored and
# must NEVER be committed.
#
# Values below are safe local-development placeholders only.
# ===========================================================================

# --- Backend (Spring Boot) ---
# Spring profile: local (development) or prod (production).
SOFTYFY_PROFILE=local

# HTTP port exposed by the backend.
SERVER_PORT=8080

# Comma-separated list of origins allowed to call the backend API (CORS).
# In production set this to the real frontend origin(s); never "*" with
# credentials. Default is the Vite dev server origin.
SOFTYFY_CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL (used by docker-compose.yml and the backend) ---
SOFTYFY_DB_HOST=localhost
SOFTYFY_DB_PORT=5432
SOFTYFY_DB_NAME=softyfy
SOFTYFY_DB_USER=softyfy
# Dev-only placeholder. Use a strong random value in any real environment.
SOFTYFY_DB_PASSWORD=softyfy

# --- Audio storage & uploads ---
# Storage provider. Only "local" is implemented in this phase; the value is
# persisted in audio_file.storage_provider so new providers can be added later.
SOFTYFY_STORAGE_PROVIDER=local

# Root directory for the local storage provider. Must NOT live inside the repo,
# frontend build output, or the database. The value is resolved relative to the
# backend working directory (default: ./data/audio).
SOFTYFY_STORAGE_LOCAL_ROOT=./data/audio

# Maximum accepted audio upload size, in megabytes (default 200). Also used to
# configure Spring's multipart limits.
SOFTYFY_AUDIO_MAX_FILE_SIZE_MB=200

# --- Frontend (Vite build-time) ---
# Base URL of the backend API consumed by the frontend.
# For local development this is the Spring Boot instance on localhost.
VITE_API_BASE_URL=http://localhost:8080
